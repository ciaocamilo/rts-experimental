{
  "name": "rts-experimental",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "RTS experimental, SDD v0.3. Incremento P0-A.",
  "scripts": {
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "predev": "npm run vendor:pyodide",
    "dev": "vite",
    "prebuild": "npm run vendor:pyodide",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
