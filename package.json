    "test:py": "python -m unittest discover -s python/tests -t python",
    "preview": "vite preview"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "pyodide": "0.27.7",
    "typescript": "7.0.2",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
